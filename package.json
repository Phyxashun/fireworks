{
  "name": "fireworks",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "bun run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "lint:fix": "oxlint src --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "check": "bun run typecheck && bun run lint && bun run fmt:check",
    "compile": "bun run ../pendex/packages/utils/src/cli.ts"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@tweakpane/plugin-essentials": "^0.2.1",
    "pendex": "link:pendex",
    "picocolors": "^1.1.1",
    "tweakpane": "^4.0.5"
  },
  "devDependencies": {
    "@tweakpane/core": "^2.0.5",
    "@types/bun": "^1.4.2",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2004",
    "typescript": "7.0.2",
    "vite": "^8.3.4"
  }
}
