# EditorConfig is awesome: https://editorconfig.org
root = true

# ===============================================
# Global Defaults
# ===============================================
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 80

# ===============================================
# Web Ecosystem (Oxfmt / Oxlint Targets)
# ===============================================
[*.{js,jsx,ts,tsx,html,css}]
indent_size = 4

# ===============================================
# Data, Configs & Formats (2-Space Overrides)
# ===============================================
# Aligned to your oxfmt `overrides` block
[*.{json,jsonc,lock,toml}]
indent_size = 2

# ===============================================
# Documentation & Visuals
# ===============================================
[*.md]
indent_size = 2
trim_trailing_whitespace = false

[*.mermaid]
indent_size = 2

# ===============================================
# Shell & System Scripts
# ===============================================
[*.{sh,bash,fish}]
indent_size = 2

[*.ps1]
end_of_line = crlf
